# mkCluster - Evaluate a cluster configuration
#
# Usage:
#   nixcluster.lib.mkCluster {
#     imports = [ nixcluster.clusterModules.k3s ];
#     members.node1 = {
#       nixosConfiguration = self.nixosConfigurations.base;
#       install.ip = "10.0.0.1";
#       networking.hostName = "prod-node1";  # NixOS patch
#     };
#   }
{ lib, inputs }:

clusterConfig:

let
  # Import CLI builder
  mkClusterCli = import ./mkClusterCli.nix { inherit lib; };

  # Core cluster module
  coreModule = ../cluster-modules/core.nix;

  # Evaluate the cluster using module system
  evaluated = lib.evalModules {
    modules = [
      coreModule
      clusterConfig
      # Thread flake inputs into the cluster config (consumed by e.g. pxe).
      { _inputs = inputs; }
    ];
  };

  cfg = evaluated.config;

  # Keys that are nixcluster-specific, not NixOS patches
  nixclusterKeys = [ "nixosConfiguration" "install" ];

  # Build final NixOS configuration for each member
  mkMemberNixosConfig = memberName: member:
    let
      # Extract NixOS patches (everything except nixcluster keys)
      nixosPatches = removeAttrs member nixclusterKeys;

      # Modules generated by extensions (k3s, etc)
      extensionModules = cfg._generatedNixosModules.${memberName} or [];

      # Cluster context for NixOS modules
      clusterContext = {
        _module.args.nixcluster = {
          cluster = cfg;
          clusterName = cfg.name;
          inherit memberName member;
        };
      };
    in
    member.nixosConfiguration.extendModules {
      modules = [
        nixosPatches
        clusterContext
      ] ++ extensionModules;
    };

  nixosConfigurations = lib.mapAttrs mkMemberNixosConfig cfg.members;

  # CLI subcommand builder: pkgs -> package
  cli = pkgs: mkClusterCli { inherit pkgs; cluster = cfg; };

in
{
  inherit (evaluated) config options;
  inherit nixosConfigurations cli;
}
